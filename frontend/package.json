{
  "name": "eurovision-stats-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "media:optimize": "npm run media:optimize:countries && npm run media:optimize:acts",
    "media:optimize:countries": "node scripts/optimize-country-heroes.mjs",
    "media:optimize:acts": "node scripts/optimize-act-media.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "framer-motion": "12.38.0",
    "lucide-react": "0.577.0",
    "next": "^15.5.20",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "20.19.37",
    "@types/react": "18.3.28",
    "autoprefixer": "10.4.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "8.5.19",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "engines": {
    "node": "22.x"
  }
